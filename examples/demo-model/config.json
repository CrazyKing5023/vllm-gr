{
  "model_type": "hstu",
  "architectures": ["HSTUEmbeddingModel"],

  "torch_dtype": "bfloat16",
  "is_text_encoder": true,
  "is_encoder_decoder": false,
  "is_attention_free": false,

  "max_seq_len": 128,
  "max_num_candidates": 50,

  "hstu_num_heads": 2,
  "hstu_attn_linear_dim": 64,
  "hstu_attn_qk_dim": 32,
  "hstu_attn_num_layers": 2,
  "hstu_embedding_table_dim": 64,
  "hstu_preprocessor_hidden_dim": 128,
  "hstu_transducer_embedding_dim": 64,

  "user_embedding_feature_names": ["item_id"],
  "item_embedding_feature_names": ["item_candidate_id"],
  "uih_post_id_feature_name": "item_id",
  "uih_action_time_feature_name": "timestamp",
  "candidates_querytime_feature_name": "query_time",
  "candidates_weight_feature_name": "",
  "candidates_watchtime_feature_name": "",

  "hstu_uih_feature_names": [
    "item_id", "timestamp"
  ],
  "hstu_candidate_feature_names": [
    "item_candidate_id", "query_time"
  ],

  "merge_uih_candidate_feature_mapping": [
    ["item_id", "item_candidate_id"],
    ["timestamp", "query_time"]
  ],

  "hash_size": 10000,
  "task_names": ["is_click"],

  "embedding_tables": [
    {
      "name": "item_embedding",
      "embedding_dim": 64,
      "num_embeddings": 10000,
      "feature_names": ["item_id", "item_candidate_id"]
    }
  ]
}
