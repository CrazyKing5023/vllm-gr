{
  "model_type": "hstu",
  "architectures": ["HSTUEmbeddingModel"],
  "is_text_encoder": true,
  "is_encoder_decoder": false,
  "is_attention_free": false,

  "max_seq_len": 128,
  "max_num_candidates": 10,
  "max_num_candidates_inference": 5,

  "hstu_num_heads": 4,
  "hstu_attn_linear_dim": 128,
  "hstu_attn_qk_dim": 128,
  "hstu_attn_num_layers": 5,
  "hstu_embedding_table_dim": 512,
  "hstu_preprocessor_hidden_dim": 256,
  "hstu_transducer_embedding_dim": 512,
  "hstu_group_norm": false,
  "hstu_input_dropout_ratio": 0.2,
  "hstu_linear_dropout_rate": 0.1,

  "contextual_feature_to_max_length": {
    "user_id": 1, "sex": 1, "age_group": 1, "occupation": 1, "zip_code": 1
  },
  "contextual_feature_to_min_uih_length": {
    "user_id": 20, "sex": 20, "age_group": 20, "occupation": 20, "zip_code": 20
  },

  "candidates_weight_feature_name": "item_action_weights",
  "candidates_watchtime_feature_name": "item_movie_rating",
  "candidates_querytime_feature_name": "item_query_time",

  "user_embedding_feature_names": [
    "movie_id", "user_id", "sex", "age_group", "occupation", "zip_code"
  ],
  "item_embedding_feature_names": ["item_movie_id"],
  "uih_post_id_feature_name": "movie_id",
  "uih_action_time_feature_name": "action_timestamp",
  "uih_weight_feature_name": "item_weights",

  "hstu_uih_feature_names": [
    "user_id", "sex", "age_group", "occupation", "zip_code",
    "movie_id", "movie_rating", "action_timestamp",
    "item_weights", "dummy_watch_time"
  ],
  "hstu_candidate_feature_names": [
    "item_movie_id", "item_movie_rating", "item_query_time",
    "item_action_weights", "item_dummy_watchtime"
  ],

  "merge_uih_candidate_feature_mapping": [
    ["movie_id", "item_movie_id"],
    ["movie_rating", "item_movie_rating"],
    ["action_timestamp", "item_query_time"],
    ["item_weights", "item_action_weights"],
    ["dummy_watch_time", "item_dummy_watchtime"]
  ],

  "action_weights": [1, 2, 4, 8, 16],
  "action_embedding_init_std": 0.1,
  "causal_multitask_weights": 0.2,
  "enable_postprocessor": true,
  "use_layer_norm_postprocessor": false,

  "hash_size": 10000000,
  "task_names": ["rating"],
  "task_types": ["binary_classification"],

  "embedding_tables": [
    {
      "name": "movie_id",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": ["movie_id", "item_movie_id"]
    },
    {
      "name": "user_id",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": ["user_id"]
    },
    {
      "name": "sex",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 8,
      "feature_names": ["sex"]
    },
    {
      "name": "age_group",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 16,
      "feature_names": ["age_group"]
    },
    {
      "name": "occupation",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 32,
      "feature_names": ["occupation"]
    },
    {
      "name": "zip_code",
      "embedding_dim": 512,
      "data_type": "fp16",
      "num_embeddings": 10000,
      "feature_names": ["zip_code"]
    }
  ]
}
