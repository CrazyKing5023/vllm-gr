{
  "model_type": "hstu",
  "architectures": ["HSTUEmbeddingModel"],

  "is_text_encoder": true,
  "is_encoder_decoder": false,
  "is_attention_free": true,

  "max_seq_len": 128,
  "max_num_candidates": 10,

  "hstu_num_heads": 2,
  "hstu_attn_linear_dim": 64,
  "hstu_attn_qk_dim": 32,
  "hstu_attn_num_layers": 2,
  "hstu_embedding_table_dim": 64,
  "hstu_preprocessor_hidden_dim": 128,
  "hstu_transducer_embedding_dim": 64,

  "contextual_feature_to_max_length": {
    "user_id": 1, "sex": 1, "age_group": 1, "occupation": 1, "zip_code": 1
  },

  "candidates_weight_feature_name": "item_action_weights",
  "candidates_watchtime_feature_name": "item_movie_rating",
  "candidates_querytime_feature_name": "item_query_time",

  "user_embedding_feature_names": [
    "movie_id", "user_id", "sex", "age_group", "occupation", "zip_code"
  ],
  "item_embedding_feature_names": ["item_movie_id"],
  "uih_post_id_feature_name": "movie_id",
  "uih_action_time_feature_name": "action_timestamp",
  "uih_weight_feature_name": "item_weights",

  "merge_uih_candidate_feature_mapping": [
    ["movie_id", "item_movie_id"],
    ["movie_rating", "item_movie_rating"],
    ["action_timestamp", "item_query_time"],
    ["item_weights", "item_action_weights"],
    ["dummy_watch_time", "item_dummy_watchtime"]
  ],

  "action_weights": [1, 2, 4, 8, 16],
  "hash_size": 10000,
  "task_names": ["rating"],
  "is_inference": true,

  "embedding_tables": [
    {
      "name": "movie_id",
      "embedding_dim": 64,
      "num_embeddings": 10000,
      "feature_names": ["movie_id", "item_movie_id"]
    },
    {
      "name": "user_id",
      "embedding_dim": 64,
      "num_embeddings": 10000,
      "feature_names": ["user_id"]
    },
    {
      "name": "sex",
      "embedding_dim": 64,
      "num_embeddings": 10,
      "feature_names": ["sex"]
    },
    {
      "name": "age_group",
      "embedding_dim": 64,
      "num_embeddings": 10,
      "feature_names": ["age_group"]
    },
    {
      "name": "occupation",
      "embedding_dim": 64,
      "num_embeddings": 30,
      "feature_names": ["occupation"]
    },
    {
      "name": "zip_code",
      "embedding_dim": 64,
      "num_embeddings": 1000,
      "feature_names": ["zip_code"]
    }
  ]
}
